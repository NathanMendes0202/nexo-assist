# --- LLM: Google Gemini (chave gratuita do Google AI Studio) ---
# Nunca commitar o .env real. Crie a chave em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# (apelido aceito: GEMINI_API_KEY)

# Modelos no formato do Mastra: provedor/modelo. O decisor roda a cada mensagem; o redator escreve a resposta.
# Para economizar cota no plano gratuito, dá para usar google/gemini-3.5-flash-lite no redator.
NEXO_DECIDER_MODEL=google/gemini-3.8-flash
NEXO_RESPONDER_MODEL=google/gemini-3.8-flash
# Outro provedor? Troque o prefixo (anthropic/..., openai/...) e defina a chave dele (ANTHROPIC_API_KEY, OPENAI_API_KEY).

# --- Regras do agent ---
NEXO_MESSAGE_LIMIT=30
# Abaixo disso o agent não decide sozinho: transfere para um analista.
NEXO_CONFIDENCE_THRESHOLD=0.6

# --- Dados ---
NEXO_DB_PATH=./data/nexo.db
# Simula a instabilidade do sistema legado de chamados (0 a 1). 0.05 = 5% das chamadas falham.
TICKETS_FAILURE_RATE=0.05

# --- Sessão ---
# Segredo que assina o cookie de login. Em produção é obrigatório (use um valor longo e aleatório).
SESSION_SECRET=

# --- Proteção contra abuso e custo (valores padrão) ---
NEXO_LOGIN_PER_IP_15MIN=20
NEXO_MESSAGES_PER_USER_PER_MIN=12
NEXO_MESSAGES_PER_IP_PER_MIN=40
# Mensagens que chegam ao modelo, por pessoa e por dia (todas as conversas somadas).
NEXO_USER_DAILY_MESSAGES=100
# Teto diário da aplicação inteira: é o limite máximo de custo, aconteça o que acontecer.
NEXO_GLOBAL_DAILY_MESSAGES=1000
