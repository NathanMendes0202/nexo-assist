# Copie para ".env" (ao lado do docker-compose.yml) e preencha. O .env NÃO vai para o Git nem para a imagem.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional. Se vazio, um valor aleatório é gerado a cada vez que o container sobe.
SESSION_SECRET=

# Opcionais (os padrões já servem para teste):
# NEXO_DECIDER_MODEL=google/gemini-3.8-flash
# NEXO_RESPONDER_MODEL=google/gemini-3.8-flash
# NEXO_USER_DAILY_MESSAGES=40
# NEXO_GLOBAL_DAILY_MESSAGES=300
