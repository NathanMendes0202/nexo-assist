{
  "name": "nexo-assist",
  "version": "0.1.0",
  "private": true,
  "description": "Nexo Assist: agent de atendimento do service desk de TI",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "chat": "tsx scripts/chat.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:dry": "tsx scripts/eval.ts --dry"
  },
  "dependencies": {
    "@mastra/core": "^1.8.0",
    "better-sqlite3": "^11.5.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
